{
  "name": "expertforum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --env-file-if-exists=.env.local scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs --required",
    "db:studio": "drizzle-kit studio",
    "deploy": "node scripts/deploy.mjs",
    "export:band": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-band-svg.mjs",
    "booth:backdrop": "node scripts/render-backdrop.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@electric-sql/pglite": "^0.5.10",
    "@google/genai": "^2.30.0",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5"
  }
}
