# ─── Database (Neon) ─────────────────────────────────────────────
# Kosongkan saat development lokal → otomatis pakai PGlite di ./.data/pglite
DATABASE_URL=

# ─── File storage (Vercel Blob) ──────────────────────────────────
# Otomatis terisi saat Blob store di-link ke project Vercel.
# Kosong → file disimpan lokal di ./.data/files (hanya untuk dev).
BLOB_READ_WRITE_TOKEN=

# ─── AI image: Higgsfield marketing-studio (Gemini opsional) ────
# Kedua key kosong → mode demo: hasil "AI" diganti versi kertas dari sketsa.
# Urutan provider yang dicoba; semuanya dalam batas waktu AI_TOTAL_TIMEOUT_MS.
# Tambah ",gemini" untuk cadangan Gemini (butuh billing).
AI_PROVIDERS=higgsfield
AI_TOTAL_TIMEOUT_MS=105000

# Higgsfield API (https://open.higgsfield.ai) — key format "id:secret"
# (atau HF_API_KEY + HF_API_SECRET terpisah)
HF_KEY=
# Model dicoba berurutan; harus menerima gambar input (sketsa).
# Cadangan opsional: marketing-studio/image,ideogram/v4.0
HF_MODELS=marketing-studio/image
# marketing-studio/image: kualitas low | medium | high, resolusi 1k | 2k | 4k
HF_QUALITY=medium
HF_RESOLUTION=2k
# ideogram/v4.0: seberapa kuat sketsa dipertahankan (1–100)
HF_IMAGE_WEIGHT=60
HF_TIMEOUT_MS=90000

# Gemini (cadangan, hanya kalau ada di AI_PROVIDERS)
GEMINI_API_KEY=
# gemini-3-pro-image (Nano Banana Pro, kualitas tertinggi)
# alternatif lebih cepat/murah: gemini-3.1-flash-image, gemini-nano-banana-2.1
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# 1K | 2K | 4K  (2K cukup untuk cetak A4 ~285 dpi)
GEMINI_IMAGE_SIZE=2K
GEMINI_TIMEOUT_MS=80000

# ─── Email (Resend) ──────────────────────────────────────────────
# Kosong → email tidak dikirim (hanya dicatat di log).
RESEND_API_KEY=
# Domain pengirim harus sudah diverifikasi di Resend
EMAIL_FROM="Astragraphia × WCCE 2026 <karya@domainkamu.com>"
EMAIL_REPLY_TO=

# ─── Akses ───────────────────────────────────────────────────────
# Password untuk /admin dan /print (wajib di production)
ADMIN_PASSWORD=
# Kunci tablet: buka /kiosk?key=XXXX sekali, tersimpan di tablet
KIOSK_KEY=

# URL publik (untuk link & QR di email/cetakan). Di Vercel otomatis
# memakai domain production bila kosong.
APP_URL=
